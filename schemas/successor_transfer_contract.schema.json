{
  "$id": "https://fleet-assurance.local/schemas/successor_transfer_contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_mode": {
            "const": "prospective_transfer"
          }
        },
        "required": [
          "contract_mode"
        ]
      },
      "then": {
        "properties": {
          "criteria_frozen": {
            "const": true
          },
          "thresholds": {
            "additionalProperties": false,
            "properties": {
              "maximum_absolute_duration_weighted_relative_bias": {
                "minimum": 0.0,
                "type": "number"
              },
              "maximum_duration_weighted_nrmse": {
                "minimum": 0.0,
                "type": "number"
              },
              "minimum_candidate_relative_improvement": {
                "minimum": 0.0,
                "type": "number"
              },
              "minimum_valid_time_blocks_per_cell": {
                "minimum": 1,
                "type": "integer"
              },
              "require_every_resource": {
                "const": true
              }
            },
            "required": [
              "maximum_absolute_duration_weighted_relative_bias",
              "maximum_duration_weighted_nrmse",
              "minimum_candidate_relative_improvement",
              "minimum_valid_time_blocks_per_cell",
              "require_every_resource"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "fit_objective": {
          "const": "duration_weighted_nonnegative_least_squares"
        },
        "fit_partition": {
          "const": "calibration"
        },
        "formula": {
          "const": "arrival_rate=background_work_per_agent_s*fleet_size+admission_work_units_per_agent*(agents_admitted/window_duration_s)"
        },
        "model_id": {
          "const": "duration-weighted-nonnegative-arrival-rate-v1"
        },
        "point_parameter_source": {
          "const": "accepted_calibration_fit"
        },
        "predictor_fields": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "fleet_size"
            },
            {
              "const": "agents_admitted"
            },
            {
              "const": "window_duration_ms"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "fit_objective",
        "fit_partition",
        "formula",
        "model_id",
        "point_parameter_source",
        "predictor_fields"
      ],
      "type": "object"
    },
    "comparator": {
      "additionalProperties": false,
      "properties": {
        "constraint": {
          "const": "coefficient_nonnegative"
        },
        "estimator": {
          "const": "max_zero_fsum_fleet_arrival_count_over_fsum_window_s_fleet_squared"
        },
        "fit_partition": {
          "const": "calibration"
        },
        "formula": {
          "const": "arrival_rate=background_only_work_per_agent_s*fleet_size"
        },
        "intercept": {
          "const": "none"
        },
        "model_id": {
          "const": "duration_weighted_background_only_nnls_v1"
        },
        "predictor": {
          "const": "fleet_size"
        },
        "response": {
          "const": "arrival_count/window_duration_s"
        },
        "scope": {
          "const": "separately_per_resource_type"
        },
        "weighting": {
          "const": "window_duration_s"
        },
        "zero_denominator_policy": {
          "const": "not_evaluable"
        }
      },
      "required": [
        "constraint",
        "estimator",
        "fit_partition",
        "formula",
        "intercept",
        "model_id",
        "predictor",
        "response",
        "scope",
        "weighting",
        "zero_denominator_policy"
      ],
      "type": "object"
    },
    "contract_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "contract_mode": {
      "enum": [
        "engineering_dry_run",
        "prospective_transfer"
      ]
    },
    "criteria_frozen": {
      "type": "boolean"
    },
    "external_validation": {
      "const": false
    },
    "operational_outcome_extension_enabled": {
      "const": false
    },
    "outcome_custody_evidence_required": {
      "const": true
    },
    "outcome_field": {
      "const": "arrival_count"
    },
    "prediction_rows_preoutcome_lock_required": {
      "const": true
    },
    "primary_estimand": {
      "const": "resource_arrival_rate_transfer"
    },
    "resource_types": {
      "allOf": [
        {
          "contains": {
            "const": "identity_issuance"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "certificate_issuance_renewal"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "authorization_policy_evaluation"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "task_dispatch_registration"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "telemetry_source_registration"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "evidence_ingest_initialization"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "supervisory_review"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "revocation_readiness"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "configuration_attestation"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "const": "dependency_registration"
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "enum": [
          "authorization_policy_evaluation",
          "certificate_issuance_renewal",
          "configuration_attestation",
          "dependency_registration",
          "evidence_ingest_initialization",
          "identity_issuance",
          "revocation_readiness",
          "supervisory_review",
          "task_dispatch_registration",
          "telemetry_source_registration"
        ]
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "runner_authorized": {
      "const": false
    },
    "schema_version": {
      "const": "1.1"
    },
    "scientific_use_authorized": {
      "const": false
    },
    "scoring": {
      "additionalProperties": false,
      "properties": {
        "absolute_relative_bias_formula": {
          "const": "abs(sum(d*(candidate-observed)))/sum(d*observed)"
        },
        "aggregation": {
          "const": "all_registered_resource_cell_pairs_must_pass"
        },
        "block_validity_rule": {
          "const": "invalidate_ten_resource_block_if_any_row_censored_or_missing"
        },
        "evaluation_unit": {
          "const": "resource_type_within_registered_cell"
        },
        "metrics": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "duration_weighted_normalized_rmse"
            },
            {
              "const": "absolute_duration_weighted_relative_bias"
            },
            {
              "const": "candidate_relative_improvement_over_background_only"
            }
          ],
          "type": "array"
        },
        "missing_data_policy": {
          "const": "no_imputation_no_replacement"
        },
        "non_evaluable_policy": {
          "const": "fail_closed"
        },
        "nrmse_formula": {
          "const": "sqrt(sum(d*(candidate-observed)^2)/sum(d))/(sum(d*observed)/sum(d))"
        },
        "positive_comparator_rmse_required": {
          "const": true
        },
        "positive_observed_mean_required": {
          "const": true
        },
        "relative_improvement_formula": {
          "const": "1-sqrt(sum(d*(candidate-observed)^2)/sum(d))/sqrt(sum(d*(comparator-observed)^2)/sum(d))"
        },
        "weighting": {
          "const": "window_duration_s"
        }
      },
      "required": [
        "absolute_relative_bias_formula",
        "aggregation",
        "block_validity_rule",
        "evaluation_unit",
        "metrics",
        "missing_data_policy",
        "non_evaluable_policy",
        "nrmse_formula",
        "positive_comparator_rmse_required",
        "positive_observed_mean_required",
        "relative_improvement_formula",
        "weighting"
      ],
      "type": "object"
    },
    "thresholds": {
      "additionalProperties": false,
      "properties": {
        "maximum_absolute_duration_weighted_relative_bias": {
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "maximum_duration_weighted_nrmse": {
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_candidate_relative_improvement": {
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_valid_time_blocks_per_cell": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "require_every_resource": {
          "const": true
        }
      },
      "required": [
        "maximum_absolute_duration_weighted_relative_bias",
        "maximum_duration_weighted_nrmse",
        "minimum_candidate_relative_improvement",
        "minimum_valid_time_blocks_per_cell",
        "require_every_resource"
      ],
      "type": "object"
    },
    "uncertainty": {
      "additionalProperties": false,
      "properties": {
        "interval_level_source": {
          "const": "fit_gate_policy_bootstrap_interval_level"
        },
        "interval_type": {
          "const": "two_sided_equal_tail_percentile"
        },
        "method": {
          "const": "joint_calibration_time_block_bootstrap"
        },
        "quantile_method": {
          "const": "linear_hyndman_fan_type_7"
        },
        "replication_set": {
          "const": "successful_complete_ten_resource_joint_replications"
        },
        "scope": {
          "const": "marginal_per_row_mean_parameter_uncertainty_not_simultaneous_or_future_observation"
        }
      },
      "required": [
        "interval_level_source",
        "interval_type",
        "method",
        "quantile_method",
        "replication_set",
        "scope"
      ],
      "type": "object"
    }
  },
  "required": [
    "candidate",
    "comparator",
    "contract_id",
    "contract_mode",
    "criteria_frozen",
    "external_validation",
    "operational_outcome_extension_enabled",
    "outcome_custody_evidence_required",
    "outcome_field",
    "prediction_rows_preoutcome_lock_required",
    "primary_estimand",
    "resource_types",
    "runner_authorized",
    "schema_version",
    "scientific_use_authorized",
    "scoring",
    "thresholds",
    "uncertainty"
  ],
  "title": "Successor resource-arrival transfer contract",
  "type": "object"
}
