{
  "$id": "https://fleet-assurance.local/schemas/assurance_resource_specs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_bundle_id": {
      "pattern": "^assurance-resource-adapter-[0-9a-f]{20}$",
      "type": "string"
    },
    "resource_count": {
      "const": 10
    },
    "resources": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "identity_issuance"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "certificate_issuance_renewal"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "authorization_policy_evaluation"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "task_dispatch_registration"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "telemetry_source_registration"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "evidence_ingest_initialization"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "supervisory_review"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "revocation_readiness"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "configuration_attestation"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "resource_type": {
                "const": "dependency_registration"
              }
            },
            "required": [
              "resource_type"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "additionalProperties": false,
        "properties": {
          "admission_work_units": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "arrival_process": {
            "enum": [
              "poisson",
              "scheduled"
            ]
          },
          "background_work_per_agent_s": {
            "minimum": 0.0,
            "type": "number"
          },
          "capacity_units_per_second": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "max_wait_s": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "measurement_provenance": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "overload_behavior": {
            "enum": [
              "queue",
              "shed",
              "defer"
            ]
          },
          "parameter_class": {
            "enum": [
              "measured",
              "inferred",
              "notional"
            ]
          },
          "recovery_capacity_multiplier": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "resource_id": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "resource_type": {
            "enum": [
              "identity_issuance",
              "certificate_issuance_renewal",
              "authorization_policy_evaluation",
              "task_dispatch_registration",
              "telemetry_source_registration",
              "evidence_ingest_initialization",
              "supervisory_review",
              "revocation_readiness",
              "configuration_attestation",
              "dependency_registration"
            ]
          },
          "service_time_distribution": {
            "enum": [
              "deterministic",
              "exponential",
              "gamma"
            ]
          },
          "service_time_mean_ms": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          },
          "shedding_threshold": {
            "exclusiveMinimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "admission_work_units",
          "arrival_process",
          "background_work_per_agent_s",
          "capacity_units_per_second",
          "max_wait_s",
          "measurement_provenance",
          "overload_behavior",
          "parameter_class",
          "recovery_capacity_multiplier",
          "resource_id",
          "resource_type",
          "service_time_distribution",
          "service_time_mean_ms",
          "shedding_threshold"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "adapter_bundle_id",
    "resource_count",
    "resources"
  ],
  "title": "Adapted assurance resource specifications",
  "type": "object"
}
