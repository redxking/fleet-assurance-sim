{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet-assurance.local/schemas/assurance_resource_measurements.schema.json",
  "title": "Assurance resource measurement",
  "description": "One time-window observation used to calibrate the Stage 3A assurance resource model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "resource_id",
    "resource_type",
    "fleet_size",
    "agents_admitted",
    "arrival_count",
    "service_count",
    "queue_depth",
    "service_time_ms",
    "wait_time_ms",
    "capacity_units_per_second",
    "deadline_ms",
    "dropped_work",
    "deferred_work",
    "error_count",
    "source_type",
    "measurement_provenance"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "identity_issuance",
        "certificate_issuance_renewal",
        "authorization_policy_evaluation",
        "task_dispatch_registration",
        "telemetry_source_registration",
        "evidence_ingest_initialization",
        "supervisory_review",
        "revocation_readiness",
        "configuration_attestation",
        "dependency_registration"
      ]
    },
    "fleet_size": {"type": "integer", "minimum": 0},
    "agents_admitted": {"type": "integer", "minimum": 0},
    "arrival_count": {"type": "integer", "minimum": 0},
    "service_count": {"type": "integer", "minimum": 0},
    "queue_depth": {"type": "number", "minimum": 0},
    "service_time_ms": {"type": "number", "minimum": 0},
    "wait_time_ms": {"type": "number", "minimum": 0},
    "capacity_units_per_second": {"type": "number", "exclusiveMinimum": 0},
    "deadline_ms": {"type": "number", "exclusiveMinimum": 0},
    "dropped_work": {"type": "number", "minimum": 0},
    "deferred_work": {"type": "number", "minimum": 0},
    "error_count": {"type": "integer", "minimum": 0},
    "source_type": {
      "type": "string",
      "enum": ["measured", "replayed", "synthetic"]
    },
    "measurement_provenance": {
      "type": "string",
      "minLength": 1
    },
    "window_duration_ms": {
      "description": "Optional explicit observation-window duration. When absent, the importer derives it from consecutive timestamps for the same resource.",
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
